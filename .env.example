# Missing Captcha site key.
# Production uses the value below (also the code default). Override locally for dev
# by copying this file to .env.local and changing the key.
NEXT_PUBLIC_MISSING_CAPTCHA_SITE_KEY=rc_pk_6ac55f6e0b887fc76872d9af

# Server-only (do NOT prefix with NEXT_PUBLIC_): pin the captcha API base so the server
# never derives it from client-supplied headers. Leave empty for same-origin.
# MISSING_CAPTCHA_API_BASE=

# Optional comma-separated allowlist of trusted hosts when deriving the captcha origin
# from forwarded headers. Restricts the SSRF surface.
# MISSING_CAPTCHA_API_HOST_ALLOWLIST=farox.coop,www.farox.coop
